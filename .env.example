# Meet2Notes only listens on the loopback interface by default.
M2N_HOST=127.0.0.1
M2N_PORT=8765
M2N_LOG_LEVEL=INFO
M2N_MAX_UPLOAD_MB=2048
# M2N_DATA_DIR=/absolute/path/to/private/local/data
# M2N_MODELS_DIR=D:\Meet2Notes\Models
# M2N_FFMPEG_PATH=/absolute/path/to/ffmpeg
# Required only to download Pyannote Community-1 after accepting its model terms.
# M2N_PYANNOTE_TOKEN=hf_your_token_here
